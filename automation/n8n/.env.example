# n8n Community Edition, pinned to the upstream stable version documented at
# implementation time. Upgrade deliberately, after exporting workflows/data.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.32.7

# Host networking lets n8n reach the host's Tailnet-only Hermes dashboard.
# n8n itself remains loopback-only on this fixed listener.
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://127.0.0.1:5678
# Leave blank until a reviewed HTTPS ingress has been configured.
N8N_WEBHOOK_URL=
N8N_PROXY_HOPS=0
# HTTP is acceptable only while the UI is loopback-bound. Switch to true before
# exposing n8n behind HTTPS ingress.
N8N_SECURE_COOKIE=false

GENERIC_TIMEZONE=Asia/Seoul
TZ=Asia/Seoul

# Generated by scripts/host-install.sh. Keep this stable: rotating it without a
# credentials/database backup makes existing n8n credentials unreadable.
N8N_ENCRYPTION_KEY=

# Required by the loopback-only intake lease controller.
# Example: http://<TAILSCALE-IP>:9119

# Common GitHub webhook router. Configure only after reviewed HTTPS ingress exists.
GITHUB_ROUTER_OWNER=rhgo1749
GITHUB_ROUTER_TOPIC=hermes-agent
GITHUB_ROUTER_PUBLIC_URL=
