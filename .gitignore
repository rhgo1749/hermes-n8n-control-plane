# Host-specific n8n configuration and durable runtime data
.env
.env.local
.env.*.local
automation/n8n/state/
automation/n8n/secrets/
.n8n/

# Runtime logs and local databases
*.log
*.db
*.sqlite
*.sqlite3

# Generated or local Python state
__pycache__/
*.py[cod]
.pytest_cache/

# Never track bearer credentials or local copies of them
*.token
*.secret
*.pem
*.key
.n8n-cron-token
